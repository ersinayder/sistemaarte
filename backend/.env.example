# ─── Servidor ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=troque_esta_chave_por_algo_longo_e_aleatorio

# ─── CORS ──────────────��──────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── WhatsApp / Evolution API ──────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_ENABLED=false

# ─── NF-e ─────────────────────────────────────────────────
# Caminho absoluto para o certificado A1 (.pfx) no servidor
# O arquivo .pfx NUNCA vai ao repositório (ver .gitignore)
NFE_CERT_PATH=C:\\sistemaarte\\backend\\certs\\certificado.pfx
NFE_CERT_PASSWORD=senha_do_certificado

# '1' = produção  |  '2' = homologação (padrão)
NFE_AMBIENTE=homologacao

# CNPJ do emitente (somente números, 14 dígitos)
NFE_CNPJ_EMITENTE=00000000000000

# Inscrição Estadual do emitente
NFE_IE_EMITENTE=0000000000000
